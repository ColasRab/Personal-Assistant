# Local Mistral client only. Do not commit real tokens.
MISTRAL_API_KEY=
MCP_AUTH_TOKEN=

# Render environment variables.
WEBSITE_URL=https://your-personal-website.example
# Same random secret on the website and Render. This permits drafts, never publication.
WEBSITE_MCP_TOKEN=
# SHA-256 of a DIFFERENT random bearer token; give the original token to Mistral.
MCP_AUTH_TOKEN_SHA256=
PORT=8000
